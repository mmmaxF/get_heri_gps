# Reverse geocoder API
HOST=0.0.0.0
PORT=8020

# Local database and output
GEOCODER_AUTO_UPDATE=1
GEOCODER_UPDATE_DAYS=30
GEOCODER_DATA_URL=https://nlftp.mlit.go.jp/ksj/gml/data/N03/N03-2026/N03-20260101_56_GML.zip
GEOCODER_DB_PATH=/app/data/admin_area.sqlite
GEOCODER_OUTPUT_CSV=/app/output/geocoded_positions.csv
CSV_RETENTION_DAYS=90

# Multiviewer TCP title command
OUTPUT_ADAPTERS=multiviewer,atem
MULTIVIEWER_ENABLED=1
MULTIVIEWER_HOST=192.168.11.69
MULTIVIEWER_PORT=51069
MULTIVIEWER_COMMAND_PREFIX=STW010V010
MULTIVIEWER_DATETIME_ENABLED=1
MULTIVIEWER_DATETIME_COMMAND_PREFIX=STW010V011
MULTIVIEWER_DATETIME_FORMAT=%m/%d %H:%M:%S
MULTIVIEWER_TEXT_TEMPLATE={address_label}
MULTIVIEWER_ENCODING=shift_jis
MULTIVIEWER_TIMEOUT_SECONDS=2.0
MULTIVIEWER_SEND_ON_NOT_FOUND=0
MULTIVIEWER_DEDUP_TEXT=1
OUTPUT_QUEUE_SIZE=10

# ATEM PNG output API
ATEM_OUTPUT_URL=http://atem-output:8030/api/position
ATEM_OUTPUT_TIMEOUT_SECONDS=30.0
ATEM_CAPTURE_LINE_ENABLED=0
ATEM_CAPTURE_STATION_ENABLED=1
ATEM_CAPTURE_TIME_ENABLED=1
ATEM_CAPTURE_HEADER_TEMPLATE={atem_capture_station} {atem_capture_time}
ATEM_CAPTURE_LINE_TEMPLATE={atem_capture_header} {capture_address_label} 撮影
ATEM_CAPTURE_LINE_SHOW_ON_UNKNOWN=0
ATEM_CAPTURE_LINE_UNKNOWN_LABEL=撮影位置不明
CAPTURE_LOCATION_ENABLED=0
CAPTURE_CAMERA_HEADING_BCD_OFFSET=31
CAPTURE_CAMERA_HEADING_SCALE=0.1
CAPTURE_CAMERA_TILT_BCD_OFFSET=29
CAPTURE_CAMERA_TILT_SCALE=0.01
CAPTURE_TILT_MIN_DEGREES=1.0
CAPTURE_MAX_DISTANCE_METERS=10000

# Rotating application log
LOG_DIR=/app/logs
LOG_FILE=reverse_geocoder.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
