# ATEM PNG output API
HOST=0.0.0.0
PORT=8030

# Image generation
OUTPUT_DIR=/app/output
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080
TEXT_TEMPLATE={address_label}
FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
FONT_SIZE=72
TEXT_COLOR=255,255,255,255
MATTE_ENABLED=1
BOX_COLOR=0,0,0,180
BOX_PADDING_X=56
BOX_PADDING_Y=30
POSITION_X=96
POSITION_Y=820
POSITION_ANCHOR=top_left
TEXT_ALIGN=left
MAX_TEXT_WIDTH=1500
DEDUPE_TEXT=1
MIN_UPDATE_SECONDS=3.0

# ATEM control.
# 実機未接続時は 0 のままにするとPNG生成とプレビューだけ行います。
ATEM_ENABLED=0
ATEM_HOST=
ATEM_CONNECT_TIMEOUT_SECONDS=8.0
ATEM_UPLOAD_TIMEOUT_SECONDS=20.0
ATEM_MEDIA_POOL_SLOT=1
ATEM_MEDIA_PLAYER=1
ATEM_DSK=1
ATEM_FILL_SOURCE=3010
ATEM_KEY_SOURCE=3011
ATEM_ON_AIR=1
ATEM_UPLOAD_COMPRESS=0

# Rotating application log
LOG_DIR=/app/logs
LOG_FILE=atem_output.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
