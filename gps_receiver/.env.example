# GPS receiver web app
HOST=0.0.0.0
PORT=8010
APP_PUBLIC_HOST=127.0.0.1

# Audio/GPS input
SAMPLE_RATE=48000
GPS_BAUD=1200
GPS_MARK_HZ=1200
GPS_SPACE_HZ=1800
INPUT_CHANNELS=2
GPS_CHANNEL=4
PCM_SOCKET_HOST=0.0.0.0
PCM_SOCKET_PORT=9010
PCM_SOCKET_HEADER_MAX_BYTES=4096
CAPTURE_AGENT_CONTROL_SOCKET=/run/capture-agent/control.sock
OUTPUT_CSV=/app/output/gps_positions.csv
CSV_RETENTION_DAYS=90
WINDOW_SECONDS=20.0
DECODE_INTERVAL_SECONDS=1.0

# Service links
REVERSE_GEOCODER_URL=http://reverse-geocoder:8020/api/position
REVERSE_GEOCODER_HEALTH_PROBE_URL=http://reverse-geocoder:8020/api/health/probe
REVERSE_GEOCODER_TIMEOUT_SECONDS=3.0
ATEM_OUTPUT_HEALTH_URL=http://atem-output:8030/api/health
ATEM_OUTPUT_FREE_TEXT_URL=http://atem-output:8030/api/free-text
E2E_HEALTH_ENABLED=1
E2E_HEALTH_INTERVAL_SECONDS=300
E2E_HEALTH_TIMEOUT_SECONDS=5
E2E_HEALTH_NOTIFY_ENABLED=1
E2E_HEALTH_NOTIFY_REPEAT_SECONDS=1800
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM=
SMTP_TO=
GEOCODE_QUEUE_SIZE=1
GEOCODE_RETRY_COUNT=1
GEOCODE_RETRY_BASE_SECONDS=1.0
GPS_NO_FIX_NOTIFY_SECONDS=5.0

# Offline demodulator
GPS_DEMOD_INPUT_DIR=/app/input
GPS_DEMOD_OUTPUT_CSV=/app/output/demodulated_gps.csv
TEST_CAPTURE_DIR=../audio_capture/20260613_132355

# Rotating application log
LOG_DIR=/app/logs
LOG_FILE=gps_receiver.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_PROGRESS_SECONDS=5
